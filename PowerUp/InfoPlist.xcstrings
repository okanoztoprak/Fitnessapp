{
  "sourceLanguage": "nl",
  "strings": {
    "NSHealthShareUsageDescription": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "POWER UP leest je voeding (ook uit MyFitnessPal), gewicht, slaap en stappen uit Apple Health om je verbruik, doelen en dagelijkse activiteit te tonen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "POWER UP reads your nutrition (including from MyFitnessPal), weight, sleep and steps from Apple Health to show your expenditure, targets and daily activity."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen in testversies: POWER UP zet voorbeelddata in Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test builds only: POWER UP writes sample data to Apple Health."
          }
        }
      }
    }
  },
  "version": "1.0"
}
