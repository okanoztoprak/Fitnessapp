            "value": "Your estimated 1RM relative to your body weight, across %lld lifts."
          }
        }
      }
    },
    "Je haalde je eiwitdoel op minder dan 4 dagen. Een eiwitrijk ontbijt maakt het verschil.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hit your protein target on fewer than 4 days. A protein-rich breakfast makes the difference."
          }
        }
      }
    },
    "Je hebt alle %lld weken afgerond. Start een nieuw blok; je gewichten gaan mee.": {
